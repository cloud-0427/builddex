# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8

# Keep native methods in MainActivity for static JNI mapping
-keepclassmembers class lows.dgeon.ightr.jiagu.MainActivity {
    public native <methods>;
}

# Keep the original application just in case R8 needs it for something before it's moved
-keep class lows.dgeon.ightr.jiagu.Application { *; }

# Note: R class keep rules are now provided by :jiagu-runtime consumer rules.
